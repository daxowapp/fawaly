{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sudo Interns",
  "mainBinaryName": "sudo-interns",
  "version": "0.7.0",
  "identifier": "com.daxow.fawaly.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sudo Interns",
        "width": 1140,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Overprompted. Underpaid.",
    "longDescription": "A free, open-source workshop for your AI coding crew. Keep working in Codex or Claude Code while an advisor and supporting workers join through MCP.",
    "publisher": "Daxow and contributors",
    "copyright": "AGPL-3.0-or-later. Original idea and name by Ahmed Nagdy.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/sudo-interns-engine"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
